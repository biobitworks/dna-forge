# Challenge data is never committed. See DATA_POLICY.md.
data/
biobase/
*.zip
*.jpg
*.jpeg
*.png
*.dzi
*.i8
*.u16
slide-vectors.json
tile-meta.json
points.json
*.jsonl
# Run outputs (submissions are kept under runs/<id>/ only by explicit add)
runs/*/cache/
__pycache__/
*.pyc
.venv/
.DS_Store

# Predictions and submissions stay on the machines (they imply held-out labels)
runs/**/*.csv
runs/**/*.json
!runs/**/record.json
*.log

# Full custody files with slide ids stay local
custody/local/

# Generated challenge outputs, regardless of nested app directory
**/out/
**/submission_*.json
**/submission_*.csv
**/static_demo.html
